{
  "name": "algojudge-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "fumadocs-mdx",
    "dev": "node scripts/sync-sources.mjs && node scripts/generate-openapi.mjs && next dev",
    "build": "node scripts/sync-sources.mjs && node scripts/generate-openapi.mjs && next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:links": "node scripts/check-links.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:translations": "node scripts/check-translations.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "check:glossary": "node scripts/check-glossary.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "check:no-playground": "node scripts/check-no-playground.mjs",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "og": "node scripts/generate-og.mjs",
    "check:section-links": "node scripts/check-section-links.mjs",
    "check:fonts": "node scripts/check-fonts.mjs"
  },
  "dependencies": {
    "fumadocs-core": "16.18.1",
    "fumadocs-mdx": "15.5.0",
    "fumadocs-openapi": "11.4.1",
    "fumadocs-ui": "16.18.1",
    "mermaid": "11.17.2",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "postcss": "8.5.32",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
