# The image to run. A deployment pins a version rather than following `latest`:
# an installation that changed because somebody pulled is not a deployment. It
# said `latest` here until 0.1.0, which is the advice above and then the opposite
# of it.
#
# **The tag publishes this image.** `.github/workflows/release.yml` runs on a
# `v*` tag, builds it, proves it serves, and pushes the version, its minor, its
# major and `latest`. Nothing pulls it on a schedule, so the site runs this
# version until whoever deploys it pulls another. `docs/RELEASE.md` is how.
DOCS_IMAGE=ghcr.io/algojudge/algojudge-docs:0.2.0

# Where the container is published. The host terminates TLS and proxies to this.
DOCS_BIND=127.0.0.1
DOCS_PORT=8083
