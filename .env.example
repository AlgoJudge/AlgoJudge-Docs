# The image to run. A deployment pins a version rather than following `latest`:
# an installation that changed because somebody pulled is not a deployment.
DOCS_IMAGE=ghcr.io/algojudge/algojudge-docs:latest

# Where the container is published. The host terminates TLS and proxies to this.
DOCS_BIND=127.0.0.1
DOCS_PORT=8083
