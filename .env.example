# The image to run. A deployment pins a version rather than following `latest`:
# an installation that changed because somebody pulled is not a deployment. It
# said `latest` here until 0.1.0, which is the advice above and then the opposite
# of it.
#
# **Nothing publishes this image.** There is no release workflow here — CI builds
# it as a check and pushes nothing — so it is built from this repository and
# pushed by whoever deploys the site. `docs/RELEASE.md` is how.
DOCS_IMAGE=ghcr.io/algojudge/algojudge-docs:0.1.0

# Where the container is published. The host terminates TLS and proxies to this.
DOCS_BIND=127.0.0.1
DOCS_PORT=8083
